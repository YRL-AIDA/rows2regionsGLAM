# ===== Устройство =====
DEVICE=cpu

# ===== Тип модели (main / base / custom) =====
ROW_GLAM_TYPE=main

# ===== Данные (тренировка) — мини-датасет из debug_data/ =====
NAME_DATASET=publaynet
DATASET_PATH=debug_data/pdfs
COCO_PATH=debug_data/train_mini.json

# ===== Данные (валидация) [опционально] =====
# VAL_PATH=/path/to/val/pdfs
# VAL_COCO_PATH=/path/to/val.json
# NAME_VAL_DATASET=publaynet

# ===== Данные (тест) — те же 10 файлов =====
NAME_TEST_DATASET=publaynet
TEST_PATH=debug_data/pdfs
TEST_COCO_PATH=debug_data/train_mini.json

# ===== Кеш препроцессинга =====
CASH_PDF_PATH=debug_data/cache

# ===== Число эпох (мало для быстрой отладки) =====
EPOCHS=2
